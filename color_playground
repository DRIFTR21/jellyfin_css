@import url("https://cdn.jsdelivr.net/gh/lscambo13/ElegantFin@main/Theme/ElegantFin-jellyfin-theme-build-latest-minified.css");
@import url("https://cdn.jsdelivr.net/gh/tromoSM/better-jellyfin-ui@main/options/Remove-jellyfin-logo-from-header.css");

:root{
  --overlayPlayButtonPosition: 50%;

  --resumeCardScale: 1.25;

    /* Gradient points */
    --darkerGradientPoint: hsla(230, 7%, 1%, 1);
    --darkerGradientPointAlpha: hsla(230, 7%, 1%, 0.85);

    --lighterGradientPoint: hsla(230, 50%, 5%, 1);
    --lighterGradientPointAlpha: hsla(230, 50%, 5%, 0.85);

    /* Header / drawer */
    --headerColor: hsla(230, 50%, 5%, 0.8);
    --drawerColor: hsla(230, 50%, 3%, 0.9);

    --headerColorGradient:
        linear-gradient(
            180deg,
            hsla(230, 50%, 7%, 0.95) 30%,
            55%,
            transparent 90%
        );

    /* Borders */
    --borderColor: hsla(230, 4%, 32%, 1);
    --darkerBorderColor: hsla(230, 4%, 32%, 1);
    --lighterBorderColor: hsla(230, 0%, 100%, 0.2);

    /* Selectors */
    --selectorBackgroundColor: hsla(0, 0%, 27%, 1);
    --selectorBackgroundColorAlpha: hsla(0, 0%, 27%, 0.5);

    /* Buttons */
    --btnMiniPlayColor: hsla(230, 0%, 100%, 0.2);
    --btnMiniPlayBorderColor: hsla(230, 0%, 70%, 0.8);

}
